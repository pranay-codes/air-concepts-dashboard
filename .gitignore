# Secrets: env files are never committed, except the example templates
.env
.env.*
!.env.example
!.env.EXAMPLE

# Build output
target/
node_modules/
dist/
build/

# Test reports
test-results/
playwright-report/
output/playwright/
coverage/
surefire-reports/
failsafe-reports/

# Infrastructure parameter files with real values stay local
infra/params/*.local.json

# Source workbooks with staff personal data stay out of git; only scrubbed fixtures are committed
docs/ACSL*.xlsx

# Python tooling
__pycache__/
.pytest_cache/
.venv-infra/

# IDE
.idea/
*.iml
.vscode/
.DS_Store
