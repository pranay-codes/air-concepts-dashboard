  "components" : {
    "schemas" : {
      "SelectConnection" : {
        "type" : "object",
        "properties" : {
          "connectionId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "connectionId" ]
      },
      "XeroConnection" : {
        "type" : "object",
        "properties" : {
          "entityId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "CONNECTED", "NOT_CONNECTED", "NEEDS_RECONNECTION" ]
          },
          "organisationName" : {
            "type" : "string"
          },
          "lastConfirmedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "errorCode" : {
            "type" : "string"
          }
        },
        "required" : [ "entityId", "status" ]
      },
      "AssignInvoice" : {
        "type" : "object",
        "properties" : {
          "assigneeId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid",
            "description" : "Active staff ID; omit or use null to unassign"
          }
        }
      },
      "InvoiceOwner" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "displayName" : {
            "type" : "string"
          },
          "active" : {
            "type" : "boolean"
          }
        },
        "required" : [ "active", "displayName", "id" ]
      },
      "SalesAssignment" : {
        "type" : "object",
        "properties" : {
          "invoiceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "owner" : {
            "$ref" : "#/components/schemas/InvoiceOwner"
          }
        },
        "required" : [ "invoiceId" ]
      },
      "CreateStaff" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "displayName" : {
            "type" : "string",
            "maxLength" : 160,
            "minLength" : 0
          },
          "role" : {
            "type" : "string",
            "enum" : [ "DIRECTOR", "FINANCIAL_ADMIN", "STANDARD_USER" ]
          }
        },
        "required" : [ "displayName", "email", "role" ]
      },
      "StaffMember" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "DIRECTOR", "FINANCIAL_ADMIN", "STANDARD_USER" ]
          },
          "active" : {
            "type" : "boolean"
          }
        },
        "required" : [ "active", "displayName", "email", "id", "role" ]
      },
      "CreateEntity" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
