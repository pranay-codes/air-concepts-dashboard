    "AirConceptsStatusCheckAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": {
          "Fn::Sub": "INF-002 ${Environment} EC2 status failure; detailed monitoring is INF-005"
        },
        "Namespace": "AWS/EC2",
        "MetricName": "StatusCheckFailed",
        "Dimensions": [
          {
            "Name": "InstanceId",
            "Value": {
              "Ref": "AirConceptsBackend"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "missing",
        "AlarmActions": {
          "Fn::If": [
            "EmailAlarms",
            [
              {
                "Ref": "AirConceptsAlarmTopic"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "OKActions": {
