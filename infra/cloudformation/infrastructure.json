    "AirConceptsFrontendRoutes": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-spa"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "SPA extensionless routes; preserve missing asset errors",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n    var request = event.request;\n    var uri = request.uri;\n    if ((request.method === 'GET' || request.method === 'HEAD')\n        && uri.indexOf('/assets/') !== 0\n        && uri.substring(uri.lastIndexOf('/') + 1).indexOf('.') === -1) {\n        request.uri = '/index.html';\n    }\n    return request;\n}"
      },
      "DeletionPolicy": "Delete"
    },
    "AirConceptsFrontendDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {
            "Fn::Sub": "Air Concepts ${Environment} frontend"
          },
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": {
            "Ref": "CloudFrontPriceClass"
          },
          "Aliases": {
            "Fn::If": [
              "CustomFrontend",
              [
                {
                  "Ref": "FrontendHostname"
                }
              ],
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          "ViewerCertificate": {
            "Fn::If": [
              "CustomFrontend",
              {
                "AcmCertificateArn": {
                  "Ref": "FrontendCertificateArn"
                },
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": "TLSv1.2_2021"
              },
              {
                "CloudFrontDefaultCertificate": true
              }
            ]
          },
          "Origins": [
            {
              "Id": "private-s3",
              "DomainName": {
                "Fn::GetAtt": [
                  "AirConceptsFrontendBucket",
                  "RegionalDomainName"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              },
              "OriginAccessControlId": {
                "Ref": "AirConceptsFrontendOriginAccessControl"
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "private-s3",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "AirConceptsFrontendRoutes",
                    "FunctionARN"
                  ]
                }
              }
            ]
          }
        },
        "Tags": [
          {
            "Key": "client",
            "Value": "air-concepts"
          },
          {
            "Key": "environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "project",
            "Value": "air-concepts"
          },
          {
            "Key": "requirement",
            "Value": "INF-002"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "air-concepts-${Environment}-frontend"
            }
          }
        ]
      },
      "DeletionPolicy": "Delete"
    },
    "AirConceptsFrontendBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AirConceptsFrontendBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DistributionReadOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${AirConceptsFrontendBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${AirConceptsFrontendDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AirConceptsFrontendBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${AirConceptsFrontendBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Delete"
    },
