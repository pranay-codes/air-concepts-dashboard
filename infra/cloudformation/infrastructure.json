    },
    "AirConceptsAlarmTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Condition": "EmailAlarms",
      "Properties": {
        "Topics": [
          {
            "Ref": "AirConceptsAlarmTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "AirConceptsAlarmTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "AirConceptsStatusCheckAlarm",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Delete"
    }
