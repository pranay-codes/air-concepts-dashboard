# Copy to .env in the repo root and fill in. Never commit real values.
# Every setting, its Parameter Store name and its format: docs/configuration.md
# Read by backend (Spring, local profile) and frontend (Vite). Vite only exposes VITE_ keys to the browser.
# Format: KEY=value, no quotes. Backslashes are escape characters, so write a literal backslash as \\.

# Backend: PostgreSQL connection (use the Supabase Test project, synthetic data only)
DATABASE_URL=jdbc:postgresql://<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# Backend: Supabase Auth endpoints
SUPABASE_JWT_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Backend: the Test project ref. Startup fails unless every Supabase and database setting above points at it.
SUPABASE_TEST_PROJECT_REF=<project-ref>

# Backend: optional, defaults to "authenticated" (the audience Supabase puts on user tokens)
# SUPABASE_JWT_AUDIENCE=authenticated

# Backend: optional, defaults to the Vite dev origin. Several origins are comma-separated.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Backend: optional. Secret. Staff administration only (Supabase Auth admin API). Blank means that feature returns 503.
# SUPABASE_SERVICE_ROLE_KEY=

# Backend: optional. Xero integration. Blank means the Xero connection fails closed. Secrets stay server-side.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=https://<api-host>/api/v1/xero/callback
# XERO_FRONTEND_CALLBACK_URI=
# Base64 of 32 random bytes. Leave it out of source and of any commit.
# XERO_TOKEN_ENCRYPTION_KEY=

# Frontend: public values only, bundled into the browser build
VITE_API_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key is public by design. It still stays in .env, not in source.
VITE_SUPABASE_PUBLISHABLE_KEY=
